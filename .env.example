# ================= 基础服务 =================
# 运行环境：development / production
NODE_ENV=development

# 服务端口
PORT=8100

# 接口统一前缀（管理后台等业务接口）
API_PREFIX=/api

# JWT 密钥（生产环境务必改成强随机串）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# 允许跨域的前端地址，多个用逗号分隔；* 表示不限制
# OpenAI 兼容接口由 SDK/服务端调用，建议收紧到你的域名，例如：
# CORS_ORIGINS=https://openai.azayu.top
CORS_ORIGINS=http://localhost:3000

# ================= AI 聚合网关 =================
# 存储层：sqlite | postgres | memory
#   默认：有 DATABASE_URL 用 postgres，否则用 sqlite（小内存单机推荐）
#   单机（RK3566/4GB/8GB eMMC）保持默认 sqlite 即可，无需数据库服务
# GATEWAY_STORE=sqlite
GATEWAY_STORE=sqlite

# SQLite 数据文件路径。建议放到 SATA 盘，减少 eMMC 写入，例如：
#   SQLITE_PATH=/mnt/sata/azapp/azapp.db
SQLITE_PATH=data/azapp.db

# 限流层：redis | memory。单机默认 memory，省掉一个常驻进程
#   （多实例部署时才需要 redis 做跨进程共享）
# GATEWAY_REDIS=redis
GATEWAY_REDIS=memory

# PostgreSQL 连接串（仅 GATEWAY_STORE=postgres 时需要）
# DATABASE_URL=postgres://azapp:azapp@localhost:5432/azapp
# 是否启用 Postgres SSL
PGSSL=false

# Redis 连接串（仅 GATEWAY_REDIS=redis 时需要）
# REDIS_URL=redis://localhost:6379

# 上游密钥落库加密密钥（32 字节随机，生产必须设置）
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=change-me-a-random-32-byte-key

# 初始管理员（首次启动 / npm run seed 创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ================= 下游接入密钥（全局统一） =================
# 所有用户共用同一把密钥，不需要逐个创建令牌，也不对个别用户封禁。
GATEWAY_API_KEY=azapp888

# 全局令牌限流（0 表示不限制）
GATEWAY_RPM=60
GATEWAY_CONCURRENCY=5
GATEWAY_TPM=60000
# 日额度（token），0 表示不限
GATEWAY_DAILY_TOKEN_LIMIT=0

# 未配置任何上游密钥时自动 mock；显式关闭请设为 false
# MOCK_UPSTREAM=false

# 默认 max_tokens（用于 TPM / 日额度预估）
DEFAULT_MAX_TOKENS=1024

# ================= 三家上游 =================
# DeepSeek
UPSTREAM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_DEEPSEEK_KEY=
# 阿里云百炼（通义千问）
UPSTREAM_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_ALIYUN_KEY=
# 豆包（火山方舟）
UPSTREAM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
UPSTREAM_DOUBAO_KEY=

# ================= 默认模型映射（可选） =================
# 默认不预置任何模型，登录后台后逐个添加（推荐）。
# 仅在你希望首次启动就预置时填写，JSON 数组，每项用 provider 或 channel_id 指定渠道：
# DEFAULT_MODEL_MAPPINGS=[{"model_name":"deepseek-chat","provider":"deepseek","upstream_model":"deepseek-chat"}]
DEFAULT_MODEL_MAPPINGS=
